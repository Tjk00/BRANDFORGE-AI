{
  "name": "brandforge-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BRANDFORGE AI — Research. Name. Design. Launch. Mobile-first brand discovery and identity studio.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch --experimental-strip-types server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=server-dist/index.mjs",
    "start": "node server-dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "store:export": "tsx scripts/store-backup.ts export",
    "store:verify": "tsx scripts/store-backup.ts verify",
    "store:import": "tsx scripts/store-backup.ts import"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "sql.js": "^1.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
